      "signals": [
        "research",
        "compare",
        "investigate options",
        "what should we use"
      ],
      "preferred_agents": [
        "antigravity"
      ]
    },
    {
      "task_type": "github_issue",
      "signals": [
        "issue",
        "bug report",
